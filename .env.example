# ─────────────────────────────────────────────────────────────
#  METROPOLE LIVEWATCH — copie este arquivo para .env
#  cp .env.example .env     (o Iniciar Livewatch.bat faz isso sozinho)
#  O .env NUNCA vai pro git: é onde ficam suas chaves.
# ─────────────────────────────────────────────────────────────

# Porta do servidor web
PORT=3000

# Intervalo entre as consultas de status (segundos).
# Não abaixe muito: 60s já é bem responsivo e economiza rate limit.
POLL_INTERVAL_SECONDS=60


# ── TWITCH ───────────────────────────────────────────────────
# Crie um app em: https://dev.twitch.tv/console/apps
#  - OAuth Redirect URL: http://localhost:3000 (não é usada, mas é obrigatória)
#  - Category: Application Integration
# Depois copie o Client ID e gere um Client Secret.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=


# ── KICK ─────────────────────────────────────────────────────
# API oficial: https://kick.com/settings/developer  (aba "API Keys")
# Se deixar em branco, o app cai no endpoint público não-oficial
# (funciona, mas pode ser bloqueado pelo Cloudflare em VPS).
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=


# ── ACESSO À PÁGINA DE CADASTRO ──────────────────────────────
# Senha para editar o elenco. O painel público continua aberto.
# Deixe em branco para liberar a edição sem senha (só em rede local!).
ADMIN_PASSWORD=troque-esta-senha


# ── ARMAZENAMENTO ────────────────────────────────────────────
# Cada elenco (config) é um arquivo configs/<nome>.json — escolha no topo do painel.
# A config ativa fica lembrada em data/ativo.json (local, fora do git).
# Caminhos relativos partem da pasta do Livewatch.
# CONFIG_DIR=./configs

# Arquivo antigo (versões antes das configs). Se existir e ainda não houver
# configs/padrao.json, ele é copiado para lá na primeira vez que o servidor sobe.
DATA_FILE=./data/streamers.json
